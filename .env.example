# Plotpaper configuration. Every variable is optional — with none set, Plotpaper
# runs fully local-first (charts, exports, share links, gallery, Studio).
# Copy to .env.local for development. See docs/self-hosting.md.

# ── Branding & defaults ─────────────────────────────────────────────
# NEXT_PUBLIC_SITE_NAME=Plotpaper
# NEXT_PUBLIC_SITE_URL=https://plotpaper.example.com
# NEXT_PUBLIC_DEFAULT_LOCALE=en          # en | es
# NEXT_PUBLIC_DEFAULT_THEME=clean        # clean | paper | midnight | newsprint | pastel | forest | blueprint | emerald
# NEXT_PUBLIC_DEFAULT_SIZE=landscape     # landscape | slide | square | portrait | story | og | a4 | compact
# NEXT_PUBLIC_CHART_BRANDING=true
# NEXT_PUBLIC_CHART_CREDIT="Made with Plotpaper"
# NEXT_PUBLIC_GITHUB_URL=https://github.com/you/plotpaper

# ── AI (Claude) — server-side only, never exposed to the browser ─────
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=anthropic                  # anthropic | mock (simulated, no key needed) | none
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium                       # low | medium | high | xhigh | max
# AI_MAX_TOKENS=16000
# AI_REFUSAL_FALLBACK=true
# AI_REQUIRE_AUTH=auto                   # auto = required when Supabase is configured
# AI_RATE_LIMIT_PER_HOUR=20
# AI_TIMEOUT_MS=120000

# ── Supabase (optional: accounts + community gallery) ────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=only-for-npm-run-seed-never-on-the-web-host
